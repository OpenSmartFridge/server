# ------------------------------------------------------------------
# SmartFridge / KitchAI - Beispiel-Konfiguration
# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# Die .env-Datei wird NICHT eingecheckt (siehe .gitignore).
# ------------------------------------------------------------------

# --- Flask ---
# Geheimer Schlüssel für Sessions. Erzeuge einen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=bitte-einen-zufaelligen-wert-eintragen
# Port, auf dem die App lauscht (prod nutzt 8008 hinter nginx).
PORT=8080
# Debug-Modus (true/false). In Produktion IMMER false.
FLASK_DEBUG=false

# --- Datenbank ---
# Speicher-Backend: "mariadb", "json" oder "auto".
#   mariadb = nur MariaDB (Fehler, wenn DB nicht erreichbar)
#   json    = nur JSON-Dateien (kein DB-Server nötig)
#   auto    = MariaDB bevorzugt, automatischer Fallback auf JSON + Re-Sync
STORAGE_BACKEND=auto

# Entweder eine komplette Verbindungs-URL angeben ...
# DATABASE_URL=mysql+pymysql://kitchai:passwort@127.0.0.1:3306/kitchai?charset=utf8mb4
# ... oder die Einzelteile (werden zu obiger URL zusammengesetzt):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kitchai
DB_PASSWORD=bitte-db-passwort-eintragen
DB_NAME=kitchai

# Verzeichnis für die JSON-Fallback-/Spiegel-Dateien
DATA_DIR=data

# --- KI / API-Keys (Startwerte; im Admin-Panel überschreibbar, Speicherung in DB) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
# Schlüssel für den externen /api/products-Endpunkt
EXTERNAL_API_KEY=
